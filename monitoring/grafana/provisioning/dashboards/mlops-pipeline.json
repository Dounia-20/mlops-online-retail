{
  "uid": "mlops-pipeline",
  "title": "MLOps - Pipeline",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Dernier pipeline : 1 = succes, 0 = echec",
     "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "pipeline_last_run_success", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "Duree du dernier pipeline (s)",
     "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "pipeline_last_run_duration_seconds", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Dernier pipeline il y a (s)",
     "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "time() - pipeline_last_run_timestamp_seconds", "refId": "A"}]},
    {"id": 4, "type": "stat", "title": "Executions par statut",
     "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "pipeline_runs", "legendFormat": "{{status}}", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "Resultat du dernier pipeline dans le temps",
     "gridPos": {"x": 0, "y": 5, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "pipeline_last_run_success", "legendFormat": "succes (1) / echec (0)", "refId": "A"}]}
  ]
}
