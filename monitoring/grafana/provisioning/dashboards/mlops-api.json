{
  "uid": "mlops-api",
  "title": "MLOps - Online Retail API",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Version du modele (champion)",
     "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "api_model_version", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "Predictions totales",
     "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(api_predictions_total)", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Erreurs /predict (5 min)",
     "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(increase(api_requests_total{endpoint=\"/predict\",status!=\"200\"}[5m])) or vector(0)", "refId": "A"}]},
    {"id": 4, "type": "stat", "title": "Latence p95 /predict (s)",
     "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])))", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "Requetes par seconde (par code HTTP)",
     "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (endpoint, status) (rate(api_requests_total[1m]))", "legendFormat": "{{endpoint}} {{status}}", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "Latence /predict (p50 et p95, secondes)",
     "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le) (rate(api_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])))", "legendFormat": "p50", "refId": "A"},
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])))", "legendFormat": "p95", "refId": "B"}]},
    {"id": 7, "type": "timeseries", "title": "Predictions par version du modele",
     "gridPos": {"x": 0, "y": 12, "w": 24, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (model_version) (increase(api_predictions_total[1m]))", "legendFormat": "v{{model_version}}", "refId": "A"}]}
  ]
}
